    <!-- Setup guide dialog -->
    <string name="setup_guide_title">Connect Your TV</string>
    <string name="setup_guide_intro">Set up Roku first, then pair the Google TV box and map its HDMI input.</string>
    <string name="guide_step_1_title">Prepare the network</string>
    <string name="guide_step_1_body">Put the phone, Roku TV, and Google TV box on the same Wi-Fi or subnet. Avoid guest Wi-Fi, VPN isolation, and router settings that block local device discovery.</string>
    <string name="guide_step_2_title">Enable Roku mobile control</string>
    <string name="guide_step_2_body">On the Roku TV, open Settings > System > Advanced system settings > Control by mobile apps > Network access, then choose Enabled or Permissive.</string>
    <string name="guide_step_3_title">Find the Roku TV</string>
    <string name="guide_step_3_body_connected">Roku is connected: %1$s.</string>
    <string name="guide_step_3_body_scan">Tap Scan Devices. If multicast discovery is blocked, use Add by IP with the Roku address and port 8060.</string>
    <string name="guide_step_4_title">Pair Google TV</string>
    <string name="guide_step_4_body_paired">Google TV is paired and ready for app/navigation commands.</string>
    <string name="guide_step_4_body_discovered">Start pairing, then enter the 6-character PIN shown on the Google TV screen.</string>
    <string name="guide_step_4_body_missing">Keep Google TV on the same network. If discovery does not appear, add its IP address on port 6466.</string>
    <string name="guide_step_5_title">Map the HDMI input</string>
    <string name="guide_step_5_body_mapped">Mapped input: %1$s.</string>
    <string name="guide_step_5_body_pick">Pick the Roku HDMI port where the Google TV box is plugged in before using Watch Google TV.</string>
    <string name="guide_pair_hdmi">Pair / HDMI</string>

