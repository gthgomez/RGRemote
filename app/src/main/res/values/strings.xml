    <!-- Permission dialogs (MainActivity) -->
    <string name="perm_wifi_title">Nearby Wi-Fi devices</string>
    <string name="perm_wifi_message">RGRemote scans your local Wi-Fi network to find Roku TVs and Google TV boxes on the same LAN. This permission is used for device discovery only—not for location tracking. The app declares neverForLocation in the manifest.</string>
    <string name="perm_wifi_continue">Continue</string>
    <string name="perm_not_now">Not now</string>
    <string name="perm_denied_title">Local network access needed</string>
    <string name="perm_denied_message">RGRemote needs nearby-network access to find and control TVs on your Wi-Fi network. Without it, device discovery finds nothing.\n\nYou previously denied this permission, so Android can\'t ask again from here. You can enable Nearby devices for RGRemote in system Settings.</string>
    <string name="perm_open_settings">Open Settings</string>

